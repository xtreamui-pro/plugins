<?php
/** @var \XtreamPro\Connector\Block\Credentials $block */
/** @var \Magento\Framework\Escaper $escaper */

$rows = $block->getRows();
$account = $block->isAccountPage();
if (!$rows) {
    if ($account) {
        echo '<div class="message info empty"><div>' . $escaper->escapeHtml(__('You have no IPTV subscriptions yet.')) . '</div></div>';
    }
    return;
}
$balance = $block->getBalance();
$login = $block->getPanelLoginUrl();
?>
<div class="block block-xtreampro-credentials">
    <div class="block-title">
        <strong><?= $escaper->escapeHtml($account ? __('Your IPTV subscriptions') : __('Your IPTV subscription')) ?></strong>
    </div>
    <div class="block-content">
        <?php foreach ($rows as $row): ?>
            <?php
            $title = $row['name'] . ($account ? ' - ' . __('Order #%1', $row['order']) : '') . ' (' . __('unit %1', $row['unit']) . ')';
            ?>
            <div class="table-wrapper">
                <table class="data table">
                    <caption class="table-caption"><?= $escaper->escapeHtml($title) ?></caption>
                    <tbody>
                    <?php if ($row['state'] === 'pending'): ?>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Status')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml(__('Being set up. Please check back in a few minutes.')) ?></td>
                        </tr>
                    <?php elseif ($row['state'] === 'ended'): ?>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Status')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml(__('Cancelled or refunded.')) ?></td>
                        </tr>
                    <?php elseif ($row['kind'] === 'line'): ?>
                        <?php $server = $block->getServerUrl($row); ?>
                        <?php if ($server !== ''): ?>
                            <tr>
                                <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Server URL')) ?></th>
                                <td class="col"><?= $escaper->escapeHtml($server) ?></td>
                            </tr>
                        <?php endif; ?>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Username')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml($row['username']) ?></td>
                        </tr>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Password')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml($row['password']) ?></td>
                        </tr>
                        <?php foreach (['m3u' => __('Playlist URL'), 'web_player' => __('Web player')] as $key => $label): ?>
                            <?php if (!empty($row['links'][$key])): ?>
                                <tr>
                                    <th scope="row" class="col label"><?= $escaper->escapeHtml($label) ?></th>
                                    <td class="col">
                                        <?php if ($block->isSafeUrl($row['links'][$key])): ?>
                                            <a href="<?= $escaper->escapeUrl($row['links'][$key]) ?>" rel="noopener noreferrer"><?= $escaper->escapeHtml($row['links'][$key]) ?></a>
                                        <?php else: ?>
                                            <?= $escaper->escapeHtml($row['links'][$key]) ?>
                                        <?php endif; ?>
                                    </td>
                                </tr>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Reseller username')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml($row['username']) ?></td>
                        </tr>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Password')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml($row['password']) ?></td>
                        </tr>
                        <tr>
                            <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Credits added by this purchase')) ?></th>
                            <td class="col"><?= $escaper->escapeHtml((string) $row['credits']) ?></td>
                        </tr>
                        <?php if ($account && $balance !== null): ?>
                            <tr>
                                <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Current credit balance')) ?></th>
                                <td class="col"><?= $escaper->escapeHtml((string) $balance) ?></td>
                            </tr>
                        <?php endif; ?>
                        <?php if ($login !== ''): ?>
                            <tr>
                                <th scope="row" class="col label"><?= $escaper->escapeHtml(__('Sign in')) ?></th>
                                <td class="col"><a href="<?= $escaper->escapeUrl($login) ?>" rel="noopener noreferrer"><?= $escaper->escapeHtml($login) ?></a></td>
                            </tr>
                        <?php endif; ?>
                    <?php endif; ?>
                    </tbody>
                </table>
            </div>
        <?php endforeach; ?>
    </div>
</div>
