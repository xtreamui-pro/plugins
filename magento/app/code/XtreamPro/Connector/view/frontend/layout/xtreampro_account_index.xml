<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title translate="true">My IPTV</title>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My IPTV</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="XtreamPro\Connector\Block\Credentials" name="xtreampro.credentials" template="XtreamPro_Connector::credentials.phtml">
                <arguments>
                    <argument name="scope" xsi:type="string">customer</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
