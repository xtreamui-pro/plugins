<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="xtreampro_connector" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Xtream UI Pro</label>
            <tab>service</tab>
            <resource>XtreamPro_Connector::config</resource>
            <group id="api" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Reseller API</label>
                <comment><![CDATA[The connector sells lines and sub-reseller accounts through the Reseller API of your Xtream UI Pro panel, with the API key of one reseller account. Creating and renewing is charged to that reseller's credits in the panel.]]></comment>
                <field id="api_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API URL</label>
                    <comment>Address of the panel's API (cmd/api), for example https://api.example.com. Without /reseller/v1. Use https: certificates are always verified.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API key</label>
                    <comment>The reseller's API key (panel dashboard, page /api-key). Only reseller accounts work. It is stored encrypted.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="panel_url" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Panel address (optional)</label>
                    <comment>Dashboard address shown to customers who bought a sub-reseller account, for example https://panel.example.com. Empty = no sign-in link.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="test_connection" translate="label" type="button" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Connection</label>
                    <frontend_model>XtreamPro\Connector\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
