{% if lines %}
  <h2>{{ xp_title_lines }}</h2>
  {% for line in lines %}
    <div class="table-responsive mb-4">
      <table class="table table-bordered">
        <thead>
          <tr>
            <td colspan="2" class="text-start"><strong>{{ line.name|e }}</strong>{% if line.order_url %} <a href="{{ line.order_url }}">{{ xp_label_order }}</a>{% endif %}</td>
          </tr>
        </thead>
        <tbody>
          {% if line.revoked %}
            <tr><td colspan="2" class="text-danger">{{ xp_text_disabled }}</td></tr>
          {% endif %}
          {% if line.server %}
            <tr><th class="text-start">{{ xp_label_server }}</th><td class="text-start">{{ line.server|e }}</td></tr>
          {% endif %}
          <tr><th class="text-start">{{ xp_label_username }}</th><td class="text-start">{{ line.username|e }}</td></tr>
          <tr><th class="text-start">{{ xp_label_password }}</th><td class="text-start">{{ line.password|e }}</td></tr>
          {% if line.playlist %}
            <tr><th class="text-start">{{ xp_label_playlist }}</th><td class="text-start"><a href="{{ line.playlist|e }}">{{ line.playlist|e }}</a></td></tr>
          {% endif %}
          {% if line.playlist_hls %}
            <tr><th class="text-start">{{ xp_label_playlist_hls }}</th><td class="text-start"><a href="{{ line.playlist_hls|e }}">{{ line.playlist_hls|e }}</a></td></tr>
          {% endif %}
          {% if line.epg %}
            <tr><th class="text-start">{{ xp_label_epg }}</th><td class="text-start"><a href="{{ line.epg|e }}">{{ line.epg|e }}</a></td></tr>
          {% endif %}
          {% if line.player %}
            <tr><th class="text-start">{{ xp_label_player }}</th><td class="text-start"><a href="{{ line.player|e }}">{{ line.player|e }}</a></td></tr>
          {% endif %}
          {% if line.live %}
            <tr><th class="text-start">{{ xp_label_status }}</th><td class="text-start">{{ line.status|e }}</td></tr>
            {% if line.expires %}
              <tr><th class="text-start">{{ xp_label_expires }}</th><td class="text-start">{{ line.expires|e }}</td></tr>
            {% endif %}
            {% if line.max_connections %}
              <tr><th class="text-start">{{ xp_label_connections }}</th><td class="text-start">{{ line.max_connections }}</td></tr>
            {% endif %}
          {% elseif line.error %}
            <tr><td colspan="2" class="text-muted">{{ xp_text_live_failed|format(line.error|e) }}</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
{% endif %}
{% if accounts %}
  <h2>{{ xp_title_account }}</h2>
  {% for account in accounts %}
    <div class="table-responsive mb-4">
      <table class="table table-bordered">
        <thead>
          <tr>
            <td colspan="2" class="text-start">{% if account.name %}<strong>{{ account.name|e }}</strong>{% endif %}{% if account.order_url %} <a href="{{ account.order_url }}">{{ xp_label_order }}</a>{% endif %}</td>
          </tr>
        </thead>
        <tbody>
          {% if account.revoked %}
            <tr><td colspan="2" class="text-danger">{{ xp_text_disabled }}</td></tr>
          {% endif %}
          <tr><th class="text-start">{{ xp_label_username }}</th><td class="text-start">{{ account.username|e }}</td></tr>
          {% if account.password %}
            <tr><th class="text-start">{{ xp_label_password }}</th><td class="text-start">{{ account.password|e }}<br/><small class="text-muted">{{ xp_text_password_once }}</small></td></tr>
          {% endif %}
          {% if account.credits %}
            <tr><th class="text-start">{{ xp_label_credits_order }}</th><td class="text-start">{{ account.credits }}</td></tr>
          {% endif %}
          {% if account.live %}
            <tr><th class="text-start">{{ xp_label_status }}</th><td class="text-start">{{ account.status|e }}</td></tr>
            <tr><th class="text-start">{{ xp_label_credits }}</th><td class="text-start">{{ account.balance }}</td></tr>
          {% elseif account.error %}
            <tr><td colspan="2" class="text-muted">{{ xp_text_live_failed|format(account.error|e) }}</td></tr>
          {% endif %}
          {% if account.login %}
            <tr><th class="text-start">{{ xp_label_signin }}</th><td class="text-start"><a href="{{ account.login|e }}">{{ account.login|e }}</a></td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
{% endif %}
