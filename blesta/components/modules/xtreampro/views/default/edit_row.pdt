<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Xtreampro.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);

$this->Widget->create($this->_('Xtreampro.edit_row.box_title', true));
?>
    <h6 class="form-section-header"><?php $this->_('Xtreampro.edit_row.basic_title'); ?></h6>

    <div class="mb-3">
        <label for="server_name" class="form-label">
            <?php $this->_('Xtreampro.row_meta.server_name'); ?>
        </label>
        <?php $this->Form->fieldText('server_name', isset($vars->server_name) ? $vars->server_name : null, [
            'id' => 'server_name',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="host_name" class="form-label">
            <?php $this->_('Xtreampro.row_meta.host_name'); ?>
        </label>
        <?php $this->Form->fieldText('host_name', isset($vars->host_name) ? $vars->host_name : null, [
            'id' => 'host_name',
            'class' => 'form-control',
        ]); ?>
        <small class="form-text text-muted"><?php $this->_('Xtreampro.row_meta.host_name_hint'); ?></small>
    </div>

    <div class="mb-3">
        <label for="port" class="form-label">
            <?php $this->_('Xtreampro.row_meta.port'); ?>
        </label>
        <?php $this->Form->fieldText('port', isset($vars->port) ? $vars->port : null, [
            'id' => 'port',
            'class' => 'form-control',
        ]); ?>
        <small class="form-text text-muted"><?php $this->_('Xtreampro.row_meta.port_hint'); ?></small>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <?php $this->Form->fieldCheckbox(
                'use_ssl',
                'true',
                (isset($vars->use_ssl) ? $vars->use_ssl : 'true') == 'true',
                ['id' => 'use_ssl', 'class' => 'form-check-input']
            ); ?>
            <label for="use_ssl" class="form-check-label">
                <?php $this->_('Xtreampro.row_meta.use_ssl'); ?>
            </label>
        </div>
    </div>

    <div class="mb-3">
        <label for="api_key" class="form-label">
            <?php $this->_('Xtreampro.row_meta.api_key'); ?>
        </label>
        <?php $this->Form->fieldPassword('api_key', [
            'id' => 'api_key',
            'class' => 'form-control',
            'autocomplete' => 'off',
        ]); ?>
        <small class="form-text text-muted"><?php $this->_('Xtreampro.row_meta.api_key_hint'); ?></small>
        <small class="form-text text-muted"><?php $this->_('Xtreampro.row_meta.api_key_keep'); ?></small>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Xtreampro.edit_row.add_btn', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>

<?php $this->Widget->end(); ?>
<?php $this->Form->end(); ?>
