<?php /** @var View $this **/ ?>

<?php if (!empty($error)) { ?>
<p class="text-danger"><?php echo $this->Html->safe($this->_('Xtreampro.service_info.error', true, $error)); ?></p>
<?php } ?>
<table class="table">
    <thead>
        <tr>
            <th><?php $this->_('Xtreampro.service_info.username'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.password'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.server'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.status'); ?></th>
            <?php if ($type === 'reseller') { ?>
            <th><?php $this->_('Xtreampro.service_info.account_id'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.credits'); ?></th>
            <?php } else { ?>
            <th><?php $this->_('Xtreampro.service_info.line_id'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.expiry'); ?></th>
            <th><?php $this->_('Xtreampro.service_info.max_connections'); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><?php echo isset($service_fields->xtreampro_username) ? $this->Html->safe($service_fields->xtreampro_username) : ''; ?></td>
            <td><?php echo isset($service_fields->xtreampro_password) ? $this->Html->safe($service_fields->xtreampro_password) : ''; ?></td>
            <td><?php echo isset($module_row->meta->host_name) ? $this->Html->safe($module_row->meta->host_name) : ''; ?></td>
            <td><?php echo isset($info['status']) ? $this->Html->safe($info['status']) : ''; ?></td>
            <?php if ($type === 'reseller') { ?>
            <td><?php echo isset($info['id']) ? $this->Html->safe($info['id']) : ''; ?></td>
            <td><?php echo isset($info['credits']) ? $this->Html->safe($info['credits']) : ''; ?></td>
            <?php } else { ?>
            <td><?php echo isset($info['id']) ? $this->Html->safe($info['id']) : ''; ?></td>
            <td><?php echo $this->Html->safe($expiry); ?></td>
            <td><?php echo isset($info['max_connections']) ? $this->Html->safe($info['max_connections']) : ''; ?></td>
            <?php } ?>
        </tr>
    </tbody>
</table>
