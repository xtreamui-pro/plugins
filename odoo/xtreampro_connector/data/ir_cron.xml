<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_xtreampro_sync_packages" model="ir.cron">
            <field name="name">Xtream UI Pro: sync packages</field>
            <field name="model_id" ref="model_xtreampro_package"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_packages()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_xtreampro_refresh_lines" model="ir.cron">
            <field name="name">Xtream UI Pro: refresh line status</field>
            <field name="model_id" ref="model_xtreampro_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_lines()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_xtreampro_refresh_resellers" model="ir.cron">
            <field name="name">Xtream UI Pro: refresh sub-reseller status and credits</field>
            <field name="model_id" ref="model_xtreampro_reseller"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_resellers()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
