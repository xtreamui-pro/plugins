<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="xtreampro_line_company_rule" model="ir.rule">
            <field name="name">Xtream UI Pro line: multi-company</field>
            <field name="model_id" ref="model_xtreampro_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="xtreampro_reseller_company_rule" model="ir.rule">
            <field name="name">Xtream UI Pro sub-reseller: multi-company</field>
            <field name="model_id" ref="model_xtreampro_reseller"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="xtreampro_credit_transfer_company_rule" model="ir.rule">
            <field name="name">Xtream UI Pro credit transfer: multi-company</field>
            <field name="model_id" ref="model_xtreampro_credit_transfer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
