<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xtreampro_credit_wizard_view_form" model="ir.ui.view">
        <field name="name">xtreampro.credit.wizard.form</field>
        <field name="model">xtreampro.credit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reseller_id"/>
                    <field name="direction"/>
                    <field name="credits"/>
                    <field name="note"/>
                </group>
                <p class="text-muted" invisible="direction != 'add'">
                    The credits are taken from your own balance on the panel.
                </p>
                <p class="text-muted" invisible="direction != 'take'">
                    Credits can be taken back only while the sub-reseller has not spent them.
                </p>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
