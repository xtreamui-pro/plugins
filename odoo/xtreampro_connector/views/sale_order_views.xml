<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_xtreampro" model="ir.ui.view">
        <field name="name">sale.order.form.xtreampro</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_xtreampro_lines" icon="fa-tv"
                        invisible="xtreampro_line_count == 0" groups="sales_team.group_sale_salesman">
                    <field name="xtreampro_line_count" widget="statinfo" string="IPTV lines"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_xtreampro_resellers" icon="fa-users"
                        invisible="xtreampro_reseller_count == 0" groups="sales_team.group_sale_salesman">
                    <field name="xtreampro_reseller_count" widget="statinfo" string="Sub-resellers"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
