<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_xtreampro" model="ir.ui.view">
        <field name="name">product.template.form.xtreampro</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Xtream UI Pro" name="xtreampro" invisible="type != 'service'">
                    <field name="type" invisible="1"/>
                    <field name="xtreampro_kind"/>
                    <field name="xtreampro_package_id" options="{'no_create': True, 'no_open': True}"
                           invisible="xtreampro_kind != 'line'"/>
                    <field name="xtreampro_trial" invisible="xtreampro_kind != 'line' or not xtreampro_package_id"/>
                    <field name="xtreampro_credits" invisible="xtreampro_kind != 'reseller'"/>
                    <field name="xtreampro_group_id" options="{'no_create': True, 'no_open': True}"
                           invisible="xtreampro_kind != 'reseller'"/>
                    <field name="xtreampro_on_cancel"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
